{
  "name": "pt-learning-lab",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20 <23" },
  "scripts": {
    "sync:pt-prompt-skill": "node scripts/sync-pt-prompt-skill.mjs",
    "dev": "next dev",
    "predev": "pnpm sync:pt-prompt-skill",
    "build": "next build",
    "prebuild": "pnpm sync:pt-prompt-skill",
    "cf-build": "opennextjs-cloudflare build",
    "precf-build": "pnpm sync:pt-prompt-skill",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "predeploy": "pnpm sync:pt-prompt-skill",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx scripts/seed-prototype.ts",
    "db:seed-programme-library": "tsx scripts/seed-programme-library.ts",
    "db:verify-content": "tsx scripts/verify-prototype.ts",
    "db:verify-learning-loop": "tsx scripts/verify-learning-loop.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "0.4.2-beta",
    "@neondatabase/serverless": "1.1.0",
    "@next/env": "16.3.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "tsx": "4.23.5",
    "typescript": "^5",
    "vitest": "4.1.10",
    "wrangler": "^4.119.0"
  },
  "packageManager": "pnpm@11.9.0"
}
